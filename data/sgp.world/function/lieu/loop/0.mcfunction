#> sgp.world:lieu/loop/0
# `{uuid: string, data: compound}`: the head of sgp:data temp.lieu.list.
# Shard 0 of 8 (generated by the location loop generator; all shards are identical apart
# from their successor). Markers 0, 8, ... run through this file, so its macro cache
# only ever holds their uuids. A marker that vanished since registration simply fails the
# `execute as` and the loop moves on.
$execute as $(uuid) at @s run function sgp.world:lieu/scan/0 with storage sgp:data temp.lieu.list[0].data
data remove storage sgp:data temp.lieu.list[0]
execute if data storage sgp:data temp.lieu.list[0] run function sgp.world:lieu/loop/1 with storage sgp:data temp.lieu.list[0]


#> sgp.bench:scenarios/abilities/common/reset_actor_position
# Restore one benchmark actor to the deterministic grid position generated by
# benchmarks/bench.py. Executed as the actor.

scoreboard players operation @s bs.pos.x = @s sgp.bench
scoreboard players remove @s bs.pos.x 1
scoreboard players operation @s bs.pos.z = @s bs.pos.x

scoreboard players set #bench_grid_width sgp.bench 8
scoreboard players operation @s bs.pos.x %= #bench_grid_width sgp.bench
scoreboard players operation @s bs.pos.z /= #bench_grid_width sgp.bench

scoreboard players set #bench_grid_spacing sgp.bench 7000
scoreboard players operation @s bs.pos.x *= #bench_grid_spacing sgp.bench
scoreboard players operation @s bs.pos.z *= #bench_grid_spacing sgp.bench
scoreboard players add @s bs.pos.x -23500
scoreboard players set @s bs.pos.y 81000
scoreboard players add @s bs.pos.z -13500

function #bs.position:set_pos {scale:0.001}
tp @s ~ ~ ~ 0 0
